{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"version": "28.4.0",
	"textdomain": "unitone",
	"name": "unitone/swiper-thumbnails",
	"title": "Swiper Thumbnails",
	"description": "Scaled previews of each slide. Connected to the nearest slider block.",
	"ancestor": [ "unitone/swiper" ],
	"attributes": {
		"columnMinWidth": {
			"type": "string",
			"default": "200px"
		}
	},
	"selectors": {
		"root": ".unitone-swiper-thumbnails"
	},
	"supports": {
		"className": false,
		"customCSS": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"unitone": {
			"gap": true
		}
	},
	"category": "unitone/component",
	"editorScript": "file:./index.js"
}
